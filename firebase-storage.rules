// Paste these rules into Firebase Console → Storage → Rules before using the booth.
// They allow QR visitors to view videos and the booth browser to upload them.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
    }
  }
}
